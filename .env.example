# The connection the running app uses. This must be a plain login role that
# does NOT own the tables, so Row Level Security applies to it.
# `npm run db:migrate` creates this role with this password if it is missing.
DATABASE_URL=postgresql://aljazayeh:CHANGE_ME@localhost:5432/aljazayeh

# Owner connection, used only by `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL_ADMIN=postgresql://postgres:CHANGE_ME@localhost:5432/aljazayeh

# The owner's login, created by `npm run db:seed`: the one account that can
# create companies. Required in production. Without it, development gets
# admin / admin.
# OWNER_USERNAME=owner
# OWNER_PASSWORD=CHANGE_ME

# Signs login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
